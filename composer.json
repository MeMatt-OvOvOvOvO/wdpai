{
    "name": "topr/rescue",
    "description": "TOPR Rescue - system zarzadzania akcjami ratowniczymi (projekt WDPAI)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "classmap": [
            "src/Controllers/",
            "src/Repository/",
            "src/Entity/",
            "src/Services/"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/Unit/"
        ]
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "test:unit": "phpunit --configuration phpunit.xml.dist --testsuite Unit",
        "test:integration": "bash tests/Integration/run.sh"
    }
}
